---
import type { Day, Stats } from '../lib/journal';

interface Props {
  days: Day[]; // newest first
  stats: Stats;
}
const { days, stats } = Astro.props;

function level(count: number): string {
  if (count === 0) return '0';
  if (count === 1) return '1';
  if (count <= 3) return '2';
  return '3';
}
---

<aside class="river-panel" aria-label="Journal activity">
  <div class="streak-block">
    <span class="eyebrow">Current streak</span>
    <div class="streak-number">
      {stats.currentStreak}
      <span class="unit">{stats.currentStreak === 1 ? 'day' : 'days'}</span>
    </div>
    <div class="streak-sub">Best run: {stats.longestStreak} {stats.longestStreak === 1 ? 'day' : 'days'}</div>
  </div>

  <div class="river-block thin-scroll">
    <span class="eyebrow">Commit river</span>
    <ol class="river">
      {days.map((day) => {
        const formatted = new Date(day.date + 'T00:00:00').toLocaleDateString('en-US', {
          month: 'short',
          day: 'numeric',
        });
        return (
          <li class="river-row">
            <a href={`#day-${day.date}`} class="river-dot-link" data-scroll-target={day.date} title={`${day.date}: ${day.entries.length} ${day.entries.length === 1 ? 'entry' : 'entries'}`}>
              <span class={`river-dot level-${level(day.entries.length)}`}></span>
              <span class="river-date">{formatted}</span>
            </a>
          </li>
        );
      })}
    </ol>
  </div>
</aside>

<style>
  .river-panel {
    position: sticky;
    top: 4.75rem;
    max-height: calc(100vh - 6rem);
    padding: 1.75rem 0 2rem 0.25rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .eyebrow {
    display: block;
    font-family: var(--font-display);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-tertiary);
    margin-bottom: 0.8rem;
  }

  .streak-block {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1.1rem 1.2rem;
    flex-shrink: 0;
  }
  .streak-number {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 700;
    color: var(--accent);
    line-height: 1;
  }
  .streak-number .unit {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-secondary);
    margin-left: 0.35rem;
  }
  .streak-sub {
    margin-top: 0.6rem;
    font-size: 0.76rem;
    color: var(--text-secondary);
  }

  .river-block {
    min-height: 0;
    overflow-y: auto;
    padding-right: 0.4rem;
  }

  .river {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
  }
  /* the continuous vertical branch line running through every dot */
  .river::before {
    content: '';
    position: absolute;
    left: 3px;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 1px;
    background: linear-gradient(to bottom, var(--branch-line), var(--border) 85%);
  }

  .river-row + .river-row {
    margin-top: 0.15rem;
  }

  .river-dot-link {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.28rem 0.4rem 0.28rem 0;
    position: relative;
    font-family: var(--font-display);
    font-size: 0.72rem;
    color: var(--text-tertiary);
    border-radius: 5px;
    transition: color 0.15s ease, background 0.15s ease;
  }
  .river-dot-link:hover {
    color: var(--text-secondary);
    background: var(--surface);
    text-decoration: none;
  }

  .river-dot {
    position: relative;
    z-index: 1;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    flex-shrink: 0;
  }
  .level-1 {
    background: var(--branch-soft);
    border-color: var(--branch-line);
  }
  .level-2 {
    background: rgba(111, 185, 168, 0.5);
    border-color: var(--branch-line);
  }
  .level-3 {
    background: var(--branch);
    border-color: var(--branch);
  }

  .river-date {
    white-space: nowrap;
  }

  .river-dot-link.active {
    color: var(--accent);
  }
  .river-dot-link.active .river-dot {
    background: var(--accent);
    border-color: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
    transform: scale(1.3);
  }
</style>
