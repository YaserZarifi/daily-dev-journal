---
import type { Entry } from '../lib/journal';

interface Props {
  entry: Entry;
  index: number;
}
const { entry, index } = Astro.props;

const exactTime = entry.commitTime
  ? new Date(entry.commitTime).toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hour12: true })
  : '';
---

<article class="entry" id={`entry-${entry.slug}`} data-tags={entry.tags.join(',')} data-mood={entry.mood}>
  <div class="entry-head">
    <span class="entry-index">#{index}</span>
    <h3>{entry.title}</h3>
    {exactTime && <span class="entry-time" title={entry.commitTime}>{exactTime}</span>}
    {entry.mood && <span class="entry-mood">{entry.mood}</span>}
  </div>
  {entry.tags.length > 0 && (
    <div class="entry-tags">
      {entry.tags.map((tag) => <span class="entry-tag">{tag}</span>)}
    </div>
  )}
  <div class="entry-prose" set:html={entry.html} />
</article>

<style>
  .entry {
    background: var(--surface);
    border: 1px solid var(--border);
    border-left: 2px solid transparent;
    border-radius: 10px;
    padding: 1.5rem 1.6rem;
    scroll-margin-top: 5.5rem;
    transition: border-color 0.15s ease, background 0.15s ease;
  }
  .entry:hover {
    border-color: var(--border-strong);
    border-left-color: var(--branch);
    background: var(--surface-hover);
  }

  .entry-head {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    margin-bottom: 0.9rem;
  }
  .entry-index {
    font-family: var(--font-display);
    font-size: 0.75rem;
    color: var(--accent);
    background: var(--accent-soft);
    border-radius: 4px;
    padding: 0.1em 0.45em;
    flex-shrink: 0;
  }
  h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text);
    unicode-bidi: plaintext;
  }

  .entry-time {
    font-family: var(--font-display);
    font-size: 0.72rem;
    color: var(--text-tertiary);
    flex-shrink: 0;
  }

  .entry-mood {
    margin-left: auto;
    font-size: 0.85rem;
    flex-shrink: 0;
  }

  .entry-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 0.9rem;
  }
  .entry-tag {
    font-family: var(--font-display);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-tertiary);
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.15em 0.5em;
  }
</style>
