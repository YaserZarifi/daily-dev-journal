---
interface Props {
  oldestEntrySlug?: string;
}
const { oldestEntrySlug } = Astro.props;
---

<header class="hero">
  <div class="prompt">
    <span class="prompt-sign">$</span> tail -f daily-dev-journal/<span class="cursor">_</span>
  </div>
  <h1>Daily&nbsp;Dev&nbsp;Journal</h1>
  <p class="tagline">
    Notes I send myself from a Telegram bot at whatever hour the idea shows up.
    A Cloudflare Worker commits them to <code>main</code>; this page rebuilds itself.
  </p>
  {oldestEntrySlug && (
    <a href={`#entry-${oldestEntrySlug}`} id="read-from-start" class="read-from-start">
      Read from the beginning →
    </a>
  )}
</header>

<style>
  .hero {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 3.5rem 1.5rem 2.5rem;
    opacity: 0;
    animation: rise 0.5s ease-out 0.05s forwards;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .prompt {
    font-family: var(--font-display);
    font-size: 0.8rem;
    color: var(--text-tertiary);
    margin-bottom: 1.25rem;
  }
  .prompt-sign {
    color: var(--accent);
  }
  .cursor {
    animation: blink 1.1s steps(1) infinite;
    color: var(--accent);
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  h1 {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 5vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0 0 1rem;
    color: var(--text);
  }

  .tagline {
    font-size: 1.05rem;
    color: var(--text-secondary);
    max-width: 34rem;
    margin: 0;
  }
  .tagline code {
    font-family: var(--font-display);
    color: var(--accent);
    background: var(--accent-soft);
    padding: 0.1em 0.4em;
    border-radius: 4px;
    font-size: 0.9em;
  }

  .read-from-start {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1.5rem;
    font-family: var(--font-display);
    font-size: 0.85rem;
    color: var(--accent);
    border: 1px solid var(--accent-line);
    background: var(--accent-soft);
    padding: 0.55rem 1.1rem;
    border-radius: 8px;
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  .read-from-start:hover {
    background: rgba(242, 184, 75, 0.18);
    border-color: var(--accent);
    text-decoration: none;
  }
</style>
