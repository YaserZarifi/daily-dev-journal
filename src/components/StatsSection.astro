---
import type { Stats } from '../lib/journal';

interface Props {
  stats: Stats;
}
const { stats } = Astro.props;

// Arrange the 84-day heatmap into 12 columns of 7 (oldest -> newest, left to right).
const columns: { date: string; count: number }[][] = [];
for (let i = 0; i < stats.heatmap.length; i += 7) {
  columns.push(stats.heatmap.slice(i, i + 7));
}

// "Today" = the most recent day the heatmap actually has data for, not the
// build server's clock — this page rebuilds on every commit, so the last
// entry in the array is effectively "now" and avoids timezone drift.
const today = stats.heatmap.at(-1)?.date ?? '';

// Fixed 1–40 scale (not relative to your busiest day), so the same count
// always renders the same color build to build. sqrt curve spreads out the
// low-to-mid range instead of a linear scale bunching everything past ~15
// visually together.
const SCALE_MAX = 40;
const GRADIENT: { t: number; rgb: [number, number, number] }[] = [
  { t: 0, rgb: [255, 250, 240] }, // white
  { t: 0.5, rgb: [247, 197, 32] }, // yellow
  { t: 1, rgb: [214, 39, 30] }, // red
];

function lerp(a: number, b: number, t: number): number {
  return a + (b - a) * t;
}

function colorFor(count: number): { fill: string; border: string } | null {
  if (count === 0) return null;
  const t = Math.sqrt(Math.min(count, SCALE_MAX) / SCALE_MAX);

  let lower = GRADIENT[0];
  let upper = GRADIENT[GRADIENT.length - 1];
  for (let i = 0; i < GRADIENT.length - 1; i++) {
    if (t >= GRADIENT[i].t && t <= GRADIENT[i + 1].t) {
      lower = GRADIENT[i];
      upper = GRADIENT[i + 1];
      break;
    }
  }
  const localT = (t - lower.t) / (upper.t - lower.t || 1);
  const rgb = lower.rgb.map((c, i) => Math.round(lerp(c, upper.rgb[i], localT))) as [number, number, number];
  const border = rgb.map((c) => Math.max(0, Math.round(c * 0.65))) as [number, number, number];

  return {
    fill: `rgb(${rgb.join(', ')})`,
    border: `rgb(${border.join(', ')})`,
  };
}
---

<section id="overview" class="overview">
  <div class="section-label">
    <span class="label">Overview</span>
    <span class="rule"></span>
  </div>

  <div class="grid">
    <div class="streak-card">
      <span class="eyebrow">Current streak</span>
      <div class="streak-number">
        {stats.currentStreak}
        <span class="unit">{stats.currentStreak === 1 ? 'day' : 'days'}</span>
      </div>
      <div class="streak-sub">Best run: {stats.longestStreak} {stats.longestStreak === 1 ? 'day' : 'days'}</div>
    </div>

    <div class="heatmap-card">
      <span class="eyebrow">Last 12 weeks</span>
      <div class="heatmap" role="img" aria-label={`Activity over the last 84 days, current streak ${stats.currentStreak} days`}>
        {columns.map((col) => (
          <div class="heatmap-col">
            {col.map((cell) => {
              const color = colorFor(cell.count);
              return (
                <span
                  class={`heatmap-cell${cell.count === 0 ? ' is-empty' : ''}${cell.date === today ? ' is-today' : ''}`}
                  style={color ? `--fill: ${color.fill}; --fill-border: ${color.border}` : undefined}
                  title={`${cell.date}: ${cell.count} ${cell.count === 1 ? 'entry' : 'entries'}`}
                ></span>
              );
            })}
          </div>
        ))}
      </div>
      <div class="heatmap-legend">
        <span>Less</span>
        {[0, 1, 10, 20, 30, 40].map((n) => {
          const color = colorFor(n);
          return (
            <span
              class="heatmap-cell"
              style={color ? `--fill: ${color.fill}; --fill-border: ${color.border}` : undefined}
            ></span>
          );
        })}
        <span>More</span>
      </div>
    </div>
  </div>

  <div class="tiles">
    <div class="tile">
      <dt>Total entries</dt>
      <dd>{stats.totalEntries}</dd>
    </div>
    <div class="tile">
      <dt>Weeks logged</dt>
      <dd>{stats.totalWeeks}</dd>
    </div>
    <div class="tile">
      <dt>Avg. per active day</dt>
      <dd>{stats.avgPerActiveDay}</dd>
    </div>
    <div class="tile">
      <dt>Most active day</dt>
      <dd>{stats.mostActiveWeekday}</dd>
    </div>
  </div>
</section>

<style>
  .overview {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 1.5rem 3.5rem;
  }

  .section-label {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 1.5rem;
  }
  .label {
    font-family: var(--font-display);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-tertiary);
    white-space: nowrap;
  }
  .rule {
    flex: 1;
    height: 1px;
    background: var(--border);
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .streak-card,
  .heatmap-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1.5rem 1.6rem;
  }

  .eyebrow {
    display: block;
    font-family: var(--font-display);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-tertiary);
    margin-bottom: 0.9rem;
  }

  .streak-card {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .streak-number {
    font-family: var(--font-display);
    font-size: 3rem;
    font-weight: 700;
    color: var(--accent);
    line-height: 1;
  }
  .streak-number .unit {
    font-size: 1rem;
    font-weight: 500;
    color: var(--text-secondary);
    margin-left: 0.4rem;
  }
  .streak-sub {
    margin-top: 0.9rem;
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  .heatmap {
    display: flex;
    gap: 4px;
    width: 100%;
  }
  .heatmap-col {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 4px;
  }
  .heatmap-cell {
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: 2px;
    background: var(--fill, var(--bg-elevated));
    border: 1px solid var(--fill-border, var(--border));
  }

  .heatmap-cell.is-today {
    border-color: var(--accent);
    animation: today-glow 2.4s ease-in-out infinite;
  }
  @keyframes today-glow {
    0%,
    100% {
      box-shadow: 0 0 0 0 rgba(242, 184, 75, 0.45);
    }
    50% {
      box-shadow: 0 0 7px 2px rgba(242, 184, 75, 0.8);
    }
  }

  .heatmap-legend {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 1rem;
    font-size: 0.72rem;
    color: var(--text-tertiary);
  }
  .heatmap-legend .heatmap-cell {
    width: 10px;
    height: 10px;
  }

  .tiles {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }
  .tile {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1.1rem 1.2rem;
  }
  .tile dt {
    font-size: 0.72rem;
    color: var(--text-tertiary);
    margin-bottom: 0.4rem;
  }
  .tile dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--text);
  }

  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .tiles {
      grid-template-columns: repeat(2, 1fr);
    }
    .heatmap {
      overflow-x: auto;
      padding-bottom: 0.25rem;
    }
  }
</style>
