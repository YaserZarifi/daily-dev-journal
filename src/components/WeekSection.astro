---
import type { Week } from '../lib/journal';
import DayRow from './DayRow.astro';

interface Props {
  week: Week;
}
const { week } = Astro.props;

const weekNum = week.week.split('-W')[1];
const year = week.week.split('-W')[0];
---

<section class="week">
  <div class="week-divider">
    <svg class="branch-connector" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
      <path d="M12 0 V7 Q12 15 20 15 H24" fill="none" stroke="var(--branch)" stroke-width="2" />
      <circle cx="12" cy="7" r="3" fill="var(--branch)" />
    </svg>
    <span class="label">week/{weekNum}<span class="branch-year">·{year}</span></span>
    <span class="rule"></span>
    <span class="count">{week.entryCount} {week.entryCount === 1 ? 'commit' : 'commits'}</span>
  </div>

  <div class="days">
    {week.days.map((day, i) => (
      <DayRow day={day} isLast={i === week.days.length - 1} />
    ))}
  </div>
</section>

<style>
  .week {
    margin-bottom: 1rem;
  }

  .week-divider {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1.75rem;
  }
  .branch-connector {
    flex-shrink: 0;
  }
  .label {
    font-family: var(--font-display);
    font-size: 0.78rem;
    letter-spacing: 0.02em;
    color: var(--branch);
    white-space: nowrap;
  }
  .branch-year {
    color: var(--text-tertiary);
    text-transform: uppercase;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    margin-left: 0.3rem;
  }
  .rule {
    flex: 1;
    height: 1px;
    background: var(--border);
  }
  .count {
    font-size: 0.72rem;
    color: var(--text-tertiary);
    white-space: nowrap;
  }
</style>
