---
interface Props {
  entryCount: number;
  weekCount: number;
  lastDate: string | null;
}
const { entryCount, weekCount, lastDate } = Astro.props;

const formattedLast = lastDate
  ? new Date(lastDate + 'T00:00:00').toLocaleDateString('en-US', {
      month: 'short',
      day: 'numeric',
    })
  : '—';
---

<header class="hero">
  <div class="prompt">
    <span class="prompt-sign">$</span> tail -f daily-dev-journal/<span class="cursor">_</span>
  </div>
  <h1>Daily&nbsp;Dev&nbsp;Journal</h1>
  <p class="tagline">
    Notes I send myself from a Telegram bot at whatever hour the idea shows up.
    A Cloudflare Worker commits them to <code>main</code>; this page rebuilds itself.
  </p>

  <dl class="stats">
    <div class="stat">
      <dt>Entries</dt>
      <dd>{entryCount}</dd>
    </div>
    <div class="stat">
      <dt>Weeks logged</dt>
      <dd>{weekCount}</dd>
    </div>
    <div class="stat">
      <dt>Last entry</dt>
      <dd>{formattedLast}</dd>
    </div>
  </dl>
</header>

<style>
  .hero {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 4.5rem 1.5rem 3rem;
    opacity: 0;
    animation: rise 0.5s ease-out 0.05s forwards;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .prompt {
    font-family: var(--font-display);
    font-size: 0.8rem;
    color: var(--text-tertiary);
    margin-bottom: 1.25rem;
  }
  .prompt-sign {
    color: var(--accent);
  }
  .cursor {
    animation: blink 1.1s steps(1) infinite;
    color: var(--accent);
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  h1 {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 5vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0 0 1rem;
    color: var(--text);
  }

  .tagline {
    font-size: 1.05rem;
    color: var(--text-secondary);
    max-width: 34rem;
    margin: 0 0 2.5rem;
  }
  .tagline code {
    font-family: var(--font-display);
    color: var(--accent);
    background: var(--accent-soft);
    padding: 0.1em 0.4em;
    border-radius: 4px;
    font-size: 0.9em;
  }

  .stats {
    display: flex;
    gap: 2.5rem;
    margin: 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
  .stat dt {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-tertiary);
    margin-bottom: 0.35rem;
  }
  .stat dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--accent);
  }

  @media (max-width: 480px) {
    .stats {
      gap: 1.5rem;
      flex-wrap: wrap;
    }
  }
</style>
