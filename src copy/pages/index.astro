---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import WeekSection from '../components/WeekSection.astro';
import { getEntries, groupByDay, groupByWeek } from '../lib/journal';

const entries = getEntries();
const days = groupByDay(entries);
const weeks = groupByWeek(days);
const lastDate = days[0]?.date ?? null;
---

<Layout>
  <Hero entryCount={entries.length} weekCount={weeks.length} lastDate={lastDate} />

  <main class="log">
    {weeks.length === 0 ? (
      <div class="empty">
        <p><span class="prompt-sign">$</span> No entries found yet.</p>
        <p class="hint">Push a journal entry and merge it into <code>main</code> — this page rebuilds on its own.</p>
      </div>
    ) : (
      weeks.map((week) => <WeekSection week={week} />)
    )}
  </main>

  <footer class="site-footer">
    <a href="https://github.com/YaserZarifi/daily-dev-journal" target="_blank" rel="noopener noreferrer">
      view source →
    </a>
    <span>built with Astro · deployed on GitHub Pages</span>
  </footer>
</Layout>

<style>
  .log {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 1.5rem 2rem;
  }

  .empty {
    font-family: var(--font-display);
    color: var(--text-secondary);
    padding: 2rem 0;
  }
  .empty .prompt-sign {
    color: var(--accent);
  }
  .empty .hint {
    color: var(--text-tertiary);
    font-size: 0.85rem;
  }
  .empty code {
    color: var(--accent);
  }

  .site-footer {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 2.5rem 1.5rem 4rem;
    border-top: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.8rem;
    color: var(--text-tertiary);
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
